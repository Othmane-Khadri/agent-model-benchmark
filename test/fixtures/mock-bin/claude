#!/usr/bin/env node
// test/fixtures/mock-bin/claude
import { readFileSync, existsSync, writeFileSync } from 'node:fs';
const argv = process.argv.slice(2);
// Read prompt: stdin (models/judges configured prompt_via stdin) or last arg.
let prompt = '';
try { prompt = readFileSync(0, 'utf8'); } catch {}
if (!prompt) prompt = argv[argv.length - 1] || '';

const isJudge = prompt.includes('"winner"') || prompt.includes('ANSWER A');
if (isJudge) {
  let w = process.env.MOCK_JUDGE_WINNER || 'a';
  const winnerText = process.env.MOCK_JUDGE_WINNER_TEXT;
  if (winnerText) {
    // Split prompt into A/B blocks and detect which block contains the winner text
    const sepA = '--- ANSWER A ---', sepB = '--- ANSWER B ---';
    const idxA = prompt.indexOf(sepA), idxB = prompt.indexOf(sepB);
    if (idxA !== -1 && idxB !== -1) {
      const blockA = prompt.slice(idxA + sepA.length, idxB);
      const blockB = prompt.slice(idxB + sepB.length);
      w = blockA.includes(winnerText) ? 'a' : blockB.includes(winnerText) ? 'b' : w;
    }
  }
  process.stdout.write(JSON.stringify({ result: JSON.stringify({
    output_a: { criteria: { quality: { reason: 'mock', score: w === 'a' ? 5 : 3 } }, overall: w === 'a' ? 5 : 3 },
    output_b: { criteria: { quality: { reason: 'mock', score: w === 'b' ? 5 : 3 } }, overall: w === 'b' ? 5 : 3 },
    winner: w }), usage: { input_tokens: 5, output_tokens: 5 }, num_turns: 1 }));
  process.exit(0);
}
// Model invocation: honor scripted error trial via a counter file.
const counterFile = process.env.MOCK_COUNTER_FILE;
if (counterFile && process.env.MOCK_MODEL_ERROR_TRIAL != null) {
  let n = existsSync(counterFile) ? Number(readFileSync(counterFile, 'utf8')) : 0;
  writeFileSync(counterFile, String(n + 1));
  if (n === Number(process.env.MOCK_MODEL_ERROR_TRIAL)) { process.stderr.write('scripted error'); process.exit(3); }
}
process.stdout.write(JSON.stringify({ result: process.env.MOCK_MODEL_OUTPUT || '2019',
  usage: { input_tokens: 8, output_tokens: 4 }, num_turns: 1 }));
